{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch (Client Side)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "sourceMaps": true,
            "pathMapping": {
                "/": "${workspaceFolder}", // This is the most important one.
            }
        },
        {
            "name": "Attach (Server Side)",
            "type": "node",
            "request": "attach",
            "port": 9230, // The port from the message above
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}